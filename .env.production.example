# ==============================================================================
# PRODUCTION ENVIRONMENT VARIABLES TEMPLATE - FRONTEND (VITE)
# Note: These values are compiled into the client-side SPA build.
# VITE_ENCRYPTION_KEY must match the backend's ENCRYPTION_KEY exactly.
# ==============================================================================

# Payment Settings
VITE_PAYMENT_MODE=live
VITE_RAZORPAY_KEY_ID=rzp_live_your_production_key_id_here

# Unified Backend Service API Base URL
VITE_API_URL=https://www.theabilitypeople.org/api
VITE_CONTACT_API_URL=https://www.theabilitypeople.org

# Shared Client-Side Encryption Key
# 32-byte key formatted as 64 hex characters (must match backend's ENCRYPTION_KEY)
VITE_ENCRYPTION_KEY=your_production_64_hex_encryption_key_here
